{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["tools/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "tools/ast-dataflow/__tests__/fixtures"]
}
